# ==============================================================================
# ELÉTRICAI INDUSTRIAL OS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit real API keys, service role tokens, or secrets to Git.
# - All AI provider keys below are SERVER-SIDE ONLY (never prefix with VITE_).
# - Copy this file to `.env` and replace placeholder values with valid credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SAFE APPLICATION & SUPABASE CONFIG
# ------------------------------------------------------------------------------
PUBLIC_APP_URL=http://127.0.0.1:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PLACEHOLDER_DO_NOT_USE
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SUPABASE CREDENTIALS (NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET não é mais usado pelo servidor (verificação HS256 local removida
# na auditoria P0-SEC-020). Tokens são validados via JWKS assimétrico ou GoTrue.

# Bypass de autenticação SOMENTE para desenvolvimento local/E2E. Exige NODE_ENV
# development|test e nunca vale em VERCEL_ENV production/preview. Deixe ausente fora do lab.
# ELETRICAI_ALLOW_DEV_AUTH_BYPASS=true

# ------------------------------------------------------------------------------
# 3. ELÉTRICAI CENTRAL AI GATEWAY & MODEL ROUTER (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Primary provider: gemini | deepseek | openai | anthropic | ollama | openai-compatible
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_PLACEHOLDER_REPLACE_WITH_REAL_GEMINI_KEY
GEMINI_MODEL=gemini-3-flash-preview

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-placeholder-replace-with-real-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-placeholder-replace-with-real-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-placeholder-replace-with-real-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI-Compatible Custom Endpoint (vLLM, Azure OpenAI, OpenRouter, Groq, etc.)
AI_COMPATIBLE_API_KEY=sk-compatible-placeholder-key
AI_COMPATIBLE_MODEL=meta-llama/llama-3.3-70b-instruct
AI_COMPATIBLE_BASE_URL=https://api.example-llm-provider.com/v1

# Ollama Local Runtime (Development Only — Backend Reachable)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & OBSERVABILITY (UPSTASH REDIS)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=PLACEHOLDER_UPSTASH_REDIS_TOKEN

# ------------------------------------------------------------------------------
# 5. BILLING & PAYMENTS (STRIPE / MERCADO PAGO)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER_STRIPE_WEBHOOK_SECRET
VITE_STRIPE_PRICE_BASIC_MONTHLY=price_placeholder_basic
VITE_STRIPE_PRICE_PRO_MONTHLY=price_placeholder_pro
VITE_STRIPE_PRICE_PREMIUM_MONTHLY=price_placeholder_premium
MP_ACCESS_TOKEN=APP_USR-PLACEHOLDER_MP_ACCESS_TOKEN
MP_WEBHOOK_SECRET=placeholder_mp_webhook_secret
